{
  "name": "fiscal-functions",
  "version": "1.0.0",
  "description": "Microserviço de emissão de NFC-e (motor SEFAZ reaproveitado), empacotado como Firebase Cloud Function.",
  "main": "dist/functions-entry.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions:fiscal",
    "logs": "firebase functions:log --only fiscalApi"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "axios": "^1.16.0",
    "busboy": "^1.6.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.7.3",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.0.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
