rules_version = '2';

// ============================================================
//  Regras de segurança do Firestore — Pizzaria
//  - cardapio / pedidos / usuarios_app: acessíveis ao app do
//    cliente (sem login) e ao painel. O bot usa Admin SDK e
//    ignora estas regras.
//  - Coleções administrativas (caixa, financeiro): SOMENTE
//    usuários autenticados (equipe logada no painel).
//
//  Publicar: Firebase Console > Firestore Database > Regras
//  ou via CLI: firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Cardápio: leitura pública; escrita só logado
    match /cardapio/{item} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usuários: busca e atualização de pontos
    match /usuarios_app/{userId} {
      allow read, create, update: if request.auth != null || true;
    }

    // Pedidos: cliente cria sem login; painel lê/atualiza
    match /pedidos/{pedidoId} {
      allow read, list: if true;
      allow update: if true;
      allow create: if true;
    }

    // Contador da senha do totem de autoatendimento — sem login (o totem
    // fica sozinho na loja, sem operador logado). Só um número sequencial,
    // sem dado sensível; mesmo nível de exposição que pedidos/cardapio.
    match /totem_contador/{id} {
      allow read, write: if true;
    }

    // ===== ADMINISTRATIVO (Caixa e Financeiro): só logado =====
    match /caixa_sessoes/{id} {
      allow read, write: if request.auth != null;
    }
    match /caixa_movimentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /financeiro_lancamentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /estoque_insumos/{id} {
      allow read, write: if request.auth != null;
    }
    match /estoque_movimentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /entregadores/{id} {
      allow read, write: if request.auth != null;
    }
    match /mesas/{id} {
      allow read, write: if request.auth != null;
    }
    match /comandas/{id} {
      allow read, write: if request.auth != null;
    }
    match /fornecedores/{id} {
      allow read, write: if request.auth != null;
    }
    match /configuracoes/{id} {
      allow read, write: if request.auth != null;
    }
    match /historico_conversas/{id} {
      allow read, write: if request.auth != null;
    }
    // Mensalidade do sistema: qualquer usuário logado da loja lê (pra ver
    // e pagar), mas só o fornecedor (Murilo) pode lançar/editar cobranças —
    // a loja não pode marcar a própria mensalidade como paga.
    match /mensalidades/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "contato.seusuportetec@gmail.com";
    }
    match /usuarios_admin/{id} {
      allow get: if request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email == "lileamarloja04@gmail.com"
          || id == request.auth.token.email);
      allow list: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "lileamarloja04@gmail.com";
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "lileamarloja04@gmail.com";
    }
    match /notas_fiscais/{id} {
      allow read, write: if request.auth != null;
    }
    match /dfe_documentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /fichas_tecnicas/{id} {
      allow read, write: if request.auth != null;
    }
    match /fiscal_secrets/{id} {
      allow read, write: if false;
    }
    match /integracao_secrets/{id} {
      allow read, write: if false;
    }
    match /ibpt_cache/{id} {
      allow read: if request.auth != null;
      allow write: if false; // só o serviço fiscal (Admin SDK) escreve
    }

    // ===== App do cliente (leitura pública; escrita só logado) =====
    match /app_config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cupons/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /promocoes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bloqueia qualquer outra coleção não listada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
