{
  "name": "gestorchef-test-env",
  "version": "1.0.0",
  "private": true,
  "description": "Seed, verificação e simulador ao vivo para o ambiente de testes (Firebase Emulator).",
  "scripts": {
    "seed": "node seed.js",
    "sim": "node simulator.js",
    "verify": "node verify.js",
    "test:emu": "firebase --project pizzain-40973 --config ../dashboard/firebase.json emulators:exec --only firestore,auth \"node verify.js\"",
    "demo": "firebase --project pizzain-40973 --config ../dashboard/firebase.json emulators:start",
    "demo:persist": "firebase --project pizzain-40973 --config ../dashboard/firebase.json emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "cloud:seed": "node cloud-seed.js",
    "cloud:sim": "node cloud-sim.js",
    "cloud:clean": "node cloud-clean.js",
    "cloud:deploy": "firebase --project pizzain-40973 --config ../dashboard/firebase.json deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0"
  }
}
